<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the Flutter engine starts: Night background and the mark. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI once it runs: Night background, never white. -->
    <style name="NormalTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/paisa_night</item>
    </style>
</resources>
