<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen: the Night background with the wallet mark, so the app
     opens without a white flash before Flutter draws its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/paisa_night" />
    <item>
        <bitmap android:gravity="center" android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
